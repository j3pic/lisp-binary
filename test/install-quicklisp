#!/bin/bash

LISP="$1"

set -x -e -o pipefail

wget --no-check-certificate https://beta.quicklisp.org/quicklisp.lisp

echo " Running SBCL version: " `sbcl --version`

echo "<<<<<<<<<<<<<<<<<< STATS"
echo
free -h
echo

echo '>>>>>>>>>>>>>> INSTALLING QUICKLISP'

(yes '' || true) | $LISP setup-test-environment.lisp

mkdir -p $HOME/quicklisp/local-projects

( cd ..
  dir=`pwd`
  cd ..
  echo ">>>>>>>>>>>>>>> INSTALLING $dir in $HOME/quicklisp/local-projects"
  cp -fdR $dir $HOME/quicklisp/local-projects
)

if [ -e $HOME/quicklisp/local-projects/lisp-binary/lisp-binary.asd ]; then
  echo ">>>>>>>>>>>> Lisp-Binary successfully installed in Quicklisp"
else
  echo ">>>>>>>>>>> Failed to install Lisp-Binary in $HOME/quicklisp/local-projects/lisp-binary/"
  exit 1
fi

echo -n $HOME/quicklisp/local-projects/lisp-binary/ > local-projects-dir.txt
